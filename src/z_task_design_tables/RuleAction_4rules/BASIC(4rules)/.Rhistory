# Source Files
setwd(Dir_R)
source('basic_lib.R')
source('basic_theme.R')
source('conjdim_sim_lib.R')
# --------------------------------
# Simulation settings
# --------------------------------
# Possible things to modulate (in loop)
set.seed(612)
sessN <- "TEST"#SIM_3CAT(noise_u3,2000,BC75,MIX,200u)
design <- "BASIC(4rules)"# Task space to sample neurons
BC <- 0.55; # baseline cutoff value (get this from permutation!)
niter <- 2;# number of iterations
noise_g <- 2;# general noise
# noise_u <- seq(0.5,3.5,0.25);# amount of noise
# nobs <- seq(20, 400,20) * 4;# number of observations (scale by per condition)
noise_u <- 1;# noise in units
nobs <- 100 * 12; # average 1600.9
cmb_ss <- c(.05, .1, .4, .6, .8, 1) # Proportion of labels to use (in prob)
# round(logisticM(seq(-5,5,3), 1, 1, 0.15),2)
# Summarize
axisALL <- expand.grid(1:niter, noise_u, nobs, cmb_ss)
names(axisALL) <- c("niter","noise_u", "nobs", "cmb_ss")
# --------------------------------
# Load RSA Models/Base matrices to define base features
# uL = mL for BASIC folders
# --------------------------------
g(mL, uL)  %=%  loadModel_Units(file.path(Dir_M,"w_TASKSPACE",design))
# write.table(uL$CONJ_N, file=paste0("CONJ_N_EX.txt"),sep="\t",row.names=F,col.names=F)
# --------------------------------
# Deine all possible binary pairs
# --------------------------------
clist <- 1:nrow(mL[[1]])
Tc <- 2 ^ length(clist) -2;# total number of labels
cmb_C <- expand.grid(replicate(length(clist), c("A","B"), simplify = FALSE))
cmb_C <- cmb_C[which(unlist(lapply(apply(cmb_C,1,unique),length)) >= 2),] # exclude cases where all trials are same
cmb_C <- as.matrix(cmb_C)
# Checking similarity ??
# cor(as.numeric(cmb_C[1,] %in% "A"),RULE_M[,2])
# --------------------------------
# Classification setting
# --------------------------------
control <- trainControl(method="repeatedcv",
number=4,# number of folds
repeats=4,# number of repetitions
selectionFunction = "oneSE",
sampling = "down",# rose,smote,down,up: how to balance # of observations for labels
classProbs=TRUE,allowParallel=FALSE,savePredictions=TRUE)
# --------------------------------
# Loop for simulation
# --------------------------------
registerDoMC(detectCores()-2);
results <- list(); ii <- 1; ci<-1
# Get settings (make this part flexible...)
list2env(axisALL[ii,],environment())
# --------------------------------
# Generate subsample matrices(different for every iteration)
# --------------------------------
Ts <- floor(cmb_ss * Tc)
cmb_S <- cmb_C[sample(Tc, floor(cmb_ss * Ts)),]
# --------------------------------
# Generate training/test data
# rank of each base matrix:lapply(uL, function(m){qr(m)$rank})
# rank of data
# --------------------------------
genL <-list(
ncontext = nrow(uL[[1]]), # number of classes
ntrial = nobs, # number of observations
uL = mL, # list of base units defined for each feature in RSA(uL = scaled, mL = original)
ncond = nrow(mL[[1]]), # number of non-informative units
noiseF_g = function(n) {rnorm(n,0.5,noise_g)}, # noise in noisy units
noiseF_u = function(n) {rnorm(n,0.5,noise_u)},  # noise in informative units
onoff = c("CONJ_EX"), nunits = c(100), vunits = list(CONJ_EX_F=c(1:ncol(uL$CONJ_EX))),
zeroOut = FALSE, # remove "no activity" trials for reduced feature values?
noiseOut = FALSE # remove noise from signals?
)
# --------------------------------
# Get data
# --------------------------------
ds <- genData(genL)
print(sprintf("Rank of data with noise: %d",qr(ds[,-1])$rank))
#Conditions
cmb <- paste0(cmb_S[ci,],collapse="_")
cmbIDX <- as.numeric(rownames(cmb_S)[ci])
#Relabel then run classification
C <- ds$LABEL;if(grepl("nppr",sessN)){C<-sample(C)}
ds[,`:=` (LABEL = C, RC=factor(C,labels=cmb_C[ci,]))]
m <- train(formula("RC ~ ."), data=ds[,-"LABEL"], method="lda", metric="Accuracy", trControl=control);
#Decoding results (note this is not same as dimensionality!)
r <- summary_decode(m,varL,list(PRED=TRUE,CM=TRUE,IMP=FALSE,ROC=FALSE))
r <- r[sapply(r, function(x) dim(x)[1]) > 0];# remove empty slots
rr <- r$r_acc;rr[,`:=`(cmb = cmb,cmbIDX = cmbIDX)]
rr[,Accuracy_CS := list(r$r_prob[, mean(acc), ds[["LABEL"]]]$V1)]
rr[,S_eBC := all(unlist(rr$Accuracy_CS) > BC) * 1]
rr[,Accuracy_SD := sd(rr$Accuracy_CS[[1]])]
rr
S_eBC
